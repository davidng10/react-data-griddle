{
  "name": "data-griddle",
  "version": "0.1.0",
  "description": "A virtualized React data grid with editing, frozen columns and customizable styles.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidng10/react-data-griddle.git",
    "directory": "packages/data-griddle"
  },
  "homepage": "https://github.com/davidng10/react-data-griddle#readme",
  "bugs": "https://github.com/davidng10/react-data-griddle/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "keywords": [
    "react",
    "data-grid",
    "virtualization",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "lint": "tsc --noEmit",
    "prepack": "pnpm build 1>&2 && node ../../scripts/check-package.mjs 1>&2"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.2.6",
    "react-dom": "^18.3.1 || ^19.2.6"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.2"
  }
}
